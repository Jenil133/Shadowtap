{
  "version": 1,
  "_meta": {
    "managed_by": "shadowtap-indexer",
    "description": "Replay diff results: one document per replayed capture, linked to the original and the replay trace."
  },
  "index_patterns": ["shadowtap-diffs*"],
  "data_stream": {},
  "priority": 500,
  "composed_of": ["shadowtap-settings", "shadowtap-common"],
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "event": {
          "properties": {
            "start": { "type": "date" },
            "duration": { "type": "long" }
          }
        },
        "replay": {
          "properties": {
            "run": {
              "properties": {
                "id": { "type": "keyword" }
              }
            },
            "trace": {
              "properties": {
                "id": { "type": "keyword" }
              }
            },
            "sent_at": { "type": "date" },
            "schedule_lag_us": { "type": "long" },
            "http": {
              "properties": {
                "response": {
                  "properties": {
                    "status_code": { "type": "integer" }
                  }
                }
              }
            },
            "event": {
              "properties": {
                "duration": { "type": "long" }
              }
            },
            "baseline": {
              "properties": {
                "status_code": { "type": "integer" }
              }
            }
          }
        },
        "capture": {
          "properties": {
            "id": { "type": "keyword" }
          }
        },
        "http": {
          "properties": {
            "route": { "type": "keyword", "ignore_above": 1024 },
            "request": {
              "properties": {
                "method": { "type": "keyword" }
              }
            },
            "response": {
              "properties": {
                "status_code": { "type": "integer" }
              }
            }
          }
        },
        "url": {
          "properties": {
            "path": { "type": "keyword", "ignore_above": 2048 },
            "query": { "type": "keyword", "ignore_above": 2048 }
          }
        },
        "diff": {
          "properties": {
            "schema_version": { "type": "integer" },
            "class": { "type": "keyword" },
            "reason": { "type": "text" },
            "pointers": { "type": "keyword", "ignore_above": 1024 },
            "suppressed_pointers": { "type": "keyword", "ignore_above": 1024 },
            "differences": {
              "properties": {
                "where": { "type": "keyword" },
                "pointer": { "type": "keyword", "ignore_above": 1024 },
                "kind": { "type": "keyword" },
                "prod": { "type": "keyword", "ignore_above": 1024 },
                "candidate": { "type": "keyword", "ignore_above": 1024 },
                "baseline": { "type": "keyword", "ignore_above": 1024 },
                "detail": { "type": "text" },
                "suppressed": { "type": "keyword" }
              }
            },
            "differences_truncated": { "type": "boolean" },
            "reported_count": { "type": "integer" },
            "suppressed_count": { "type": "integer" }
          }
        },
        "latency": {
          "properties": {
            "prod_us": { "type": "long" },
            "candidate_us": { "type": "long" },
            "baseline_us": { "type": "long" }
          }
        }
      }
    }
  }
}
