{
  "version": 1,
  "_meta": {
    "managed_by": "shadowtap-indexer",
    "description": "OpenTelemetry spans from every Shadowtap component and the mesh sidecars."
  },
  "index_patterns": ["traces-shadowtap-*"],
  "data_stream": {},
  "priority": 500,
  "composed_of": ["shadowtap-settings", "shadowtap-common"],
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date_nanos" },
        "event": {
          "properties": {
            "duration": { "type": "long" },
            "end": { "type": "date_nanos" }
          }
        },
        "trace": {
          "properties": {
            "state": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "span": {
          "properties": {
            "name": { "type": "keyword", "ignore_above": 1024 },
            "kind": { "type": "keyword" },
            "flags": { "type": "integer" }
          }
        },
        "scope": {
          "properties": {
            "name": { "type": "keyword" },
            "version": { "type": "keyword" }
          }
        },
        "status": {
          "properties": {
            "code": { "type": "keyword" },
            "message": { "type": "text" }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "method": { "type": "keyword" }
              }
            },
            "response": {
              "properties": {
                "status_code": { "type": "integer" }
              }
            },
            "route": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "url": {
          "properties": {
            "path": { "type": "keyword", "ignore_above": 2048 },
            "query": { "type": "keyword", "ignore_above": 2048 },
            "full": { "type": "keyword", "ignore_above": 4096 },
            "scheme": { "type": "keyword" }
          }
        },
        "server": {
          "properties": {
            "address": { "type": "keyword" },
            "port": { "type": "integer" }
          }
        },
        "user_agent": {
          "properties": {
            "original": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "links": {
          "properties": {
            "trace": {
              "properties": {
                "id": { "type": "keyword" },
                "state": { "type": "keyword", "ignore_above": 1024 }
              }
            },
            "span": {
              "properties": {
                "id": { "type": "keyword" }
              }
            },
            "attributes": { "type": "flattened", "ignore_above": 1024 }
          }
        },
        "events": {
          "properties": {
            "name": { "type": "keyword", "ignore_above": 1024 },
            "time": { "type": "date_nanos" },
            "attributes": { "type": "flattened", "ignore_above": 1024 }
          }
        },
        "dropped": {
          "properties": {
            "attributes": { "type": "integer" },
            "events": { "type": "integer" },
            "links": { "type": "integer" }
          }
        }
      }
    }
  }
}
